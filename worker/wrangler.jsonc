{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jmxsh",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
